  Requirements:
  - mulberry32 verbatim.
  - makeNoise(seed) -> reusable 2D value-noise function. I'll make it return function(x,y,scale,seedOffset) or maybe (x,y)? Spec: "write your own valueNoise(x,y,scale,seedOffset)" and "export helper makeNoise(seed) returning a reusable 2D value-noise function". So makeNoise(seed) returns valueNoise(x,y,scale,seedOffset) presumably with hashing seeded by seed.

  Implementation:

  function makeNoise(seed){
    function hash(ix,iy,off){
      var h = ix*374761393 + iy*668265263 + seed*1013904223 + off*2246822519;
      h = Math.imul(h ^ h>>>13, 1274126177);
      h = h ^ h>>>16;
      return (h>>>0)/4294967296;
    }
    function smooth(t){return t*t*(3-2*t);}
    return function(x,y,scale,off){
      var gx = x/scale, gy = y/scale;
      var x0 = Math.floor(gx), y0 = Math.floor(gy);
      var fx = smooth(gx-x0), fy = smooth(gy-y0);
      var v00=hash(x0,y0,off), v10=hash(x0+1,y0,off), v01=hash(x0,y0+1,off), v11=hash(x0+1,y0+1,off);
      var a = v00+(v10-v00)*fx;
      var b = v01+(v11-v01)*fx;
      return (a+(b-a)*fy)*2-1; // -1..1
    };
  }

