  (function(root, factory){ ... })(typeof self !== 'undefined' ? self : this, function(){
    'use strict';

    var SIZE=100, TILES=SIZE*SIZE, SONAR_R=1.6, SONAR_R2=SONAR_R*SONAR_R;
    var FREE_SPEED=9, MOW_SPEED=6.5, SNAG_SPEED=4.5, FOUL_SEC=12, SNAG_DPS... 
    var MIN=1.5, MAX=98.5;
    var FREE_SPACING=1.5;

    function mulberry32(a){...}
    var snagRng = mulberry32(0x9E3779B9);

    function clamp(v,lo,hi){...}
    function formations(spacing){ var s=spacing; return { line: [...], wedge: [...], ladder: [...] }; }

    function createSwarm(opts){
      opts=opts||{};
      var ax = typeof opts.x==='number'?opts.x:50, ay=...;
      var offs = formations(FREE_SPACING).line;
      var rovs=[];
      for (var i=0;i<6;i++) rovs.push({id:'H'+(i+1), x:ax+offs[i][0], y:ay+offs[i][1], alive:true, fouledUntil:0, hull:100});
      return { rovs:rovs, anchor:{x:ax,y:ay}, heading:0, speed:0, mode:'free', formation:'line',
        mow:{dir:1, spacing:8, rowStep:0, yRow:ay, minX:2, maxX:97, paused:false},
        stats:{tiles:0,mowTiles:0,sweeps:0,fouls:0,lost:0} };
    }

    function terrainAt(terrain, key, x, y){ var src=terrain&&terrain[key]; if(src==null) return undefined; return typeof src==='function'?src(x,y):src[y*SIZE+x]; }

    update function:

    function update(swarm, dt, input, terrain, measured, timeSec){
      input=input||{};
      var events=[], revealed=[];
      var mow=swarm.mow;

      // mode & formation controls
      if (input.mowSpacingDelta) { mow.spacing=clamp(mow.spacing+input.mowSpacingDelta,4,14); }
      mow.rowStep = 2.5*mow.spacing+2.5;
      if (input.toggleMow){
        if (swarm.mode==='mow'){ swarm.mode='free'; }
        else {
          swarm.mode='mow'; swarm.formation='line';
          mow.yRow=swarm.anchor.y; mow.paused=false;
          mow.dir = swarm.anchor.x < (mow.minX+mow.maxX)/2 ? 1 : -1;
        }
      }
      if (swarm.mode!=='mow' && (input.setFormation==='line'||input.setFormation==='wedge'||input.setFormation==='ladder')) swarm.formation=input.setFormation;
      if (swarm.mode==='mow') swarm.formation='line';

      // movement
      var a=swarm.anchor, moved=false;
      if (swarm.mode==='mow' && !mow.paused){
        var step=MOW_SPEED*dt*mow.dir;
        var nx=a.x+step;
        if (nx>=mow.maxX || nx<=mow.minX){
          nx=clamp(nx,mow.minX,mow.maxX);
          mow.dir*=-1;
          mow.yRow=clamp(mow.yRow+mow.rowStep,MIN,MAX);
          swarm.stats.sweeps++;
          events.push({type:'sweepEnd', dir:mow.dir});
        }
        var dy=mow.yRow-a.y;
        var vstep=clamp(dy,-MOW_SPEED*dt,MOW_SPEED*dt);
        var ox=a.x, oy=a.y;
        a.x=nx; a.y=a.y+vstep;
        var mdx=a.x-ox, mdy=a.y-oy;
        if (mdx||mdy){ swarm.heading=Math.atan2(mdy,mdx); moved=true; }
        swarm.speed = dt>0 ? Math.sqrt(mdx*mdx+mdy*mdy)/dt : 0; // hmm mow speed could exceed? both axes 6.5 -> 9.19. Snag threshold 4.5 fine.
      } else if (swarm.mode==='free'){
        var ax2=clamp(+input.ax||0,-1,1), ay2=clamp(+input.ay||0,-1,1);
        var mag=Math.sqrt(ax2*ax2+ay2*ay2);
        if (mag>1){ax2/=mag;ay2/=mag;mag=1;}
        if (mag>1e-6){
          var vx=ax2*FREE_SPEED*dt, vy=ay2*FREE_SPEED*dt;
          a.x=clamp(a.x+vx,MIN,MAX); a.y=clamp(a.y+vy,MIN,MAX);
          swarm.heading=Math.atan2(ay2,ax2);
          swarm.speed=FREE_SPEED*mag;
        } else swarm.speed=0;
      } else swarm.speed=0;

